rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'jalalmahmoud8000@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Admin profiles collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && request.auth.token.email == 'jalalmahmoud8000@gmail.com');
    }

    // Invoices collection
    match /invoices/{invoiceId} {
      allow read, write: if isAdmin();
    }

    // Products catalog
    match /products/{productId} {
      allow read, write: if isAdmin();
    }

    // System ping/test connection
    match /system/{docId} {
      allow read: if true;
    }
  }
}
